entrypoint = "README.md"
modules = ["nodejs-22"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "npm run web:build && npm run server:build"]
run = ["npm", "run", "server:prod"]

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"

[workflows]
runButton = "Veylo"

[[workflows.workflow]]
name = "Veylo"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run web:preview"
waitForPort = 5000
