{
  "name": "veylo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "dev": "expo start --web --port 5000 --host lan",
    "web:build": "expo export --platform web",
    "web:preview": "npm run web:build && npm run server:prod",
    "server:dev": "tsx watch server/index.ts",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outfile=dist-server/index.mjs",
    "server:prod": "NODE_ENV=production node dist-server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components contexts lib server scripts tests --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run web:build"
  },
  "dependencies": {
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.27",
    "expo-battery": "^10.0.8",
    "expo-device": "^8.0.10",
    "expo-file-system": "^19.0.21",
    "expo-font": "~14.0.10",
    "expo-network": "^8.0.8",
    "expo-router": "~6.0.17",
    "expo-sensors": "^15.0.8",
    "expo-sharing": "^14.0.8",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "express": "^5.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^9.7.6",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tsx": "^4.20.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@playwright/test": "^1.65.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.11",
    "@types/react": "~19.1.10",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "babel-preset-expo": "~54.0.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~10.0.0",
    "patch-package": "^8.0.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.2"
  },
  "private": true,
  "description": "A clearer picture of your device. Local-first Expo diagnostics for web, iOS, and Android.",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "expo-router": "~6.0.17",
    "expo-constants": "~18.0.14",
    "expo-linking": "~8.0.12",
    "react-native-worklets": "0.5.1",
    "postcss": "^8.5.23",
    "expo": "~54.0.27"
  }
}
